syntax: glob

# global files
**/db
**/saved
**/target
#un-ignore target implementations
!Mage/src/main/java/mage/target
#un-ignore the mage.db source package in Mage.Common (java source, not a database:
# EntityManager + model are required by mage-server FeedbackService; without this
# negation **/db swallowed the package and mage-server could not compile from source)
!Mage.Common/src/main/java/mage/db/
!Mage.Common/src/main/java/mage/db/**

# logs and logs rotation
*.log
*.log.*
*/gamelogs
*/gamelogsJson
*/gamesHistory

# Mage.Client
Mage.Client/plugins/images
Mage.Client/plugins/plugin.data
# TODO: must save serverlist.txt to temporary files, not root folder
Mage.Client/serverlist.txt

# Mage.Server
Mage.Server/config/init.txt
Mage.Server/extensions

# Mage.Verify
# downloadable files
Mage.Verify/*.zip
Mage.Verify/*.json

# Utils
__pycache__
Utils/data

# dev environments, IDE and OS
# IntelliJ IDEA
.idea
*.iml
# Visual Studio Code
.vscode
.history
# Eclipse
.metadata
.project
.settings
.factorypath
**/bin
**/out
# NetBeans
**/nb-configuration.xml
# Atom
.build-tools.cson
# mac os
.DS_Store

# build tools
mage-bundle.zip
.env

# build targets
/deploy
/temp

# dev tools
.devcontainer/**/*lock.json

# artefactos que generan los smoke tests al construir los iconos de carta
plugins/
