+        }
+        CardView toRemove = null;
+        for (int i = this.allCards.size() - 1; i >= 0; i--) {
+            CardView cv = this.allCards.get(i);
+            if (Objects.equals(cv.getName(), landName)) {
+                toRemove = cv;
+                break;
+            }
+        }
+        if (toRemove != null) {
+            this.removeCards(Collections.singletonList(toRemove));
+        }
+    }
