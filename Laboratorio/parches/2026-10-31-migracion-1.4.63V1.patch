+                || this.matchScoreLabel.getWidth() != scoreLabelWidth
+                || this.matchScoreLabel.getHeight() != scoreLabelHeight) {
+            this.matchScoreLabel.setBounds(scoreLabelX, 0, scoreLabelWidth, scoreLabelHeight);
+        }
