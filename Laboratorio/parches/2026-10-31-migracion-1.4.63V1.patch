+                    top = new Color(72, 86, 107);
+                    bottom = new Color(45, 56, 72);
+                }
+                if (!isEnabled()) {
+                    top = new Color(54, 60, 70);
+                    bottom = new Color(39, 44, 53);
+                }
+                int arc = Math.min(height, 20);
