+function Test-PortOpen {
+    param(
+        [string]$ComputerName,
+        [int]$Port
+    )
+    $tcp = New-Object System.Net.Sockets.TcpClient
+    try {
+        $async = $tcp.BeginConnect($ComputerName, $Port, $null, $null)
+        if (-not $async.AsyncWaitHandle.WaitOne(750)) {
+            return $false
+        }
+        $tcp.EndConnect($async)
+        return $true
+    }
+    catch {
+        return $false
+    }
+    finally {
+        $tcp.Close()
+    }
+}
