+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
+        execute();
+
+        assertPermanentCount(playerA, "Angelic Gift", 1 + 1); // card + token
+        assertTokenCount(playerA, "Angelic Gift", 1);
