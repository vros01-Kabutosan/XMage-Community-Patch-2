+        addCard(Zone.BATTLEFIELD, playerA, "Grizzly Bears"); // bear 2/2
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Angelic Gift", "Feather, Radiant Arbiter");
+        addTarget(playerA, "Grizzly Bears"); // creature to copy for
