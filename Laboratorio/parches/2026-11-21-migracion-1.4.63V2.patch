+        // If you do, that player exiles that card, then draws a card.
+        addCard(Zone.HAND, playerA, "Salt Vampire"); // {1}{B}
+        addCard(Zone.BATTLEFIELD, playerA, "Swamp", 2);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Salt Vampire");
