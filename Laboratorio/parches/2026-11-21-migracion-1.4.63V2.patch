+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Galactus, Devourer of Worlds");
+        addTarget(playerA, "Silvercoat Lion"); // exile target
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.BEGIN_COMBAT);
