+            $serverPath = [string]$serverLauncher[0]
+            Write-Log "SERVER_LAUNCHER=$serverPath"
+            $serverProcess = Start-ExistingLauncher -Path $serverPath -Label "SERVER" -RuntimeJava $activeJava8
+            $script:StartedLauncherPids += [int]$serverProcess.Id
