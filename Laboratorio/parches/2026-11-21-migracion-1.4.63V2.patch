+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Ashaya's Enduring Bond");
+        setChoice(playerA, false); // discover: put Grizzly Bears into hand
+        setChoice(playerA, true); // move to command zone (state-based action)
