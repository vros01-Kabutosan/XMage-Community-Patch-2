+            }
+        }
+        catch {
+            Write-Log "JAVA_CANDIDATE_REJECTED=$javaHomeCandidate;ERROR=$($_.Exception.Message)"
+        }
+    }
+    throw "No se encontró un JDK 17 ejecutable para compilar."
+}
