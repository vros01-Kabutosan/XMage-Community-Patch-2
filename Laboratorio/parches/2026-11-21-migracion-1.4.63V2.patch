+        // the AI sacrifices its least valuable creatures first. It must skip the second Bears, because a green
+        // creature is already chosen
+        activateAbility(1, PhaseStep.PRECOMBAT_MAIN, playerA, "{2}{W}, {T}, Sacrifice");
