+
+    @Test
+    public void test_ExileWithTwoTimeCounters() {
+        addCard(Zone.BATTLEFIELD, playerA, platform);
+        addCard(Zone.BATTLEFIELD, playerA, "Grizzly Bears"); // 2/2
+        addCard(Zone.GRAVEYARD, playerA, "Lightning Bolt");
