+        setStopAt(1, PhaseStep.END_TURN);
+        setStrictChooseMode(true);
+        execute();
+
+        assertCommandZoneCount(playerA, "Ashaya's Enduring Bond", 1);
+        assertHandCount(playerA, "Grizzly Bears", 1);
