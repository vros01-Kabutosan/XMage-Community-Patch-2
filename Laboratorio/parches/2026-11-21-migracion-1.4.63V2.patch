@@ -0,0 +1,101 @@
+package org.mage.test.cards.single.mom;
+
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import mage.filter.Filter;
+import org.junit.Test;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+/**
+ * @author DarioBarrabinoDev
+ */
+public class EssenceOfOrthodoxyTest extends CardTestPlayerBase {
+
+    /**
+     * {@link mage.cards.e.EssenceOfOrthodoxy Essence of Orthodoxy} {3}{W}{W}
+     * Creature — Phyrexian Spirit
+     * Flying
+     * Whenever Essence of Orthodoxy or another Phyrexian you control enters, incubate 2.
+     */
+    private static final String essence = "Essence of Orthodoxy";
+
+    /**
+     * {@link mage.cards.e.EleshNorn Elesh Norn // The Argent Etchings}
+     * {2}{W}, Sacrifice three other creatures: Exile Elesh Norn, then return it to the battlefield
+     * transformed under its owner's control. Activate only as a sorcery.
+     * I — Incubate 2 five times, then transform all Incubator tokens you control.
+     */
+    private static final String eleshNorn = "Elesh Norn";
+
+    @Test
+    public void test_ArgentEtchings_TransformedIncubatorsMustNotTrigger() {
+        // bug: https://github.com/magefree/mage/issues/16630
+        // Incubator tokens enter as non-Phyrexian artifacts and are transformed only afterwards,
+        // so their enter triggers must be checked against the front face
+        addCard(Zone.BATTLEFIELD, playerA, essence, 1);
+        addCard(Zone.BATTLEFIELD, playerA, eleshNorn, 1);
+        addCard(Zone.BATTLEFIELD, playerA, "Silvercoat Lion", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Plains", 3);
+
+        activateAbility(1, PhaseStep.PRECOMBAT_MAIN, playerA, "{2}{W}, Sacrifice");
+        setChoice(playerA, "Silvercoat Lion^Silvercoat Lion^Silvercoat Lion");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertPermanentCount(playerA, "The Argent Etchings", 1);
+        assertPermanentCount(playerA, "Phyrexian Token", 5);
+        assertPermanentCount(playerA, "Incubator Token", 0);
+        assertPowerToughness(playerA, "Phyrexian Token", 2, 2, Filter.ComparisonScope.All);
+    }
+
+    @Test
+    public void test_Incubate_FrontFaceMustNotTrigger() {
+        addCard(Zone.BATTLEFIELD, playerA, essence, 1);
+        // Incubate 3. Draw a card.
+        addCard(Zone.HAND, playerA, "Eyes of Gitaxias", 1); // {2}{U}
+        addCard(Zone.BATTLEFIELD, playerA, "Island", 3);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Eyes of Gitaxias");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertPermanentCount(playerA, "Incubator Token", 1);
+        assertPermanentCount(playerA, "Phyrexian Token", 0);
+    }
+
+    @Test
+    public void test_PhyrexianBackFaceEntering_MustTrigger() {
+        addCard(Zone.BATTLEFIELD, playerA, essence, 1);
+        // Incubate 3. Draw a card.
+        addCard(Zone.HAND, playerA, "Eyes of Gitaxias", 1); // {2}{U}
+        // You may have Copy Artifact enter the battlefield as a copy of any artifact on the battlefield,
+        // except it's an enchantment in addition to its other types.
+        addCard(Zone.HAND, playerA, "Copy Artifact", 1); // {1}{U}
+        addCard(Zone.BATTLEFIELD, playerA, "Island", 7);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Eyes of Gitaxias");
+        waitStackResolved(1, PhaseStep.PRECOMBAT_MAIN);
+
+        // transforming is not entering, so no trigger here
+        activateAbility(1, PhaseStep.PRECOMBAT_MAIN, playerA, "{2}: Transform");
+        waitStackResolved(1, PhaseStep.PRECOMBAT_MAIN);
+        checkPermanentCount("after transform", 1, PhaseStep.PRECOMBAT_MAIN, playerA, "Phyrexian Token", 1);
+        checkPermanentCount("after transform", 1, PhaseStep.PRECOMBAT_MAIN, playerA, "Incubator Token", 0);
+
+        // a copy of the back face enters as a Phyrexian and triggers (then dies as 0/0)
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Copy Artifact");
+        setChoice(playerA, true); // use copy
+        setChoice(playerA, "Phyrexian Token");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertPermanentCount(playerA, "Phyrexian Token", 1);
+        assertPermanentCount(playerA, "Incubator Token", 1);
+    }
+}
diff --git a/Mage.Tests/src/test/java/org/mage/test/cards/single/msc/ArchnemesisTest.java b/Mage.Tests/src/test/java/org/mage/test/cards/single/msc/ArchnemesisTest.java
new file mode 100644
index 0000000000..108b8c3af7
--- /dev/null
+++ b/Mage.Tests/src/test/java/org/mage/test/cards/single/msc/ArchnemesisTest.java
@@ -0,0 +1,183 @@
+package org.mage.test.cards.single.msc;
+
+import mage.constants.MultiplayerAttackOption;
+import mage.constants.PhaseStep;
+import mage.constants.RangeOfInfluence;
+import mage.constants.Zone;
+import mage.counters.CounterType;
+import mage.game.FreeForAll;
+import mage.game.Game;
+import mage.game.GameException;
+import mage.game.mulligan.MulliganType;
+import org.junit.Assert;
+import org.junit.Test;
+import org.mage.test.serverside.base.CardTestMultiPlayerBase;
+
+import java.io.FileNotFoundException;
+
+/**
+ * 508.3e
+ * An ability that reads "Whenever [a player] attacks [another player], . . ." triggers if one or more creatures the
+ * first player controls are declared as attackers attacking the second player. It won't trigger if a creature is put
+ * onto the battlefield attacking or if a creature attacks a planeswalker or a battle.
+ *
+ * @author JayDi85
+ */
+public class ArchnemesisTest extends CardTestMultiPlayerBase {
+
+    /**
+     * Archnemesis {1}{U}{B}
+     * Enchantment - Aura
+     * Enchant opponent
+     * Whenever you attack enchanted player, that player loses 2 life. You draw a card and gain 2 life.
+     * Whenever a player attacks you, you may attach this Aura to that player.
+     */
+    private static final String archnemesis = "Archnemesis";
+
+    @Override
+    protected Game createNewGameAndPlayers() throws GameException, FileNotFoundException {
+        Game game = new FreeForAll(MultiplayerAttackOption.MULTIPLE, RangeOfInfluence.ALL, MulliganType.GAME_DEFAULT.getMulligan(0), 20, 7);
+        // Player order: A -> D -> C -> B
+        playerA = createPlayer(game, "PlayerA");
+        playerB = createPlayer(game, "PlayerB");
+        playerC = createPlayer(game, "PlayerC");
+        playerD = createPlayer(game, "PlayerD");
+        return game;
+    }
+
+    @Test
+    public void test_AttackEnchantedPlayer() {
+        addCard(Zone.HAND, playerA, archnemesis); // {1}{U}{B}
+        addCard(Zone.BATTLEFIELD, playerA, "Underground Sea", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Grizzly Bears"); // 2/2
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, archnemesis, playerB);
+        attack(1, playerA, "Grizzly Bears", playerB);
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertLife(playerA, 20 + 2);
+        assertLife(playerB, 20 - 2 - 2); // trigger + bear
+        assertHandCount(playerA, 1 + 1); // turn draw + trigger draw
+    }
+
+    @Test
+    public void test_AttackOtherPlayerOrEnchantedPlayersPlaneswalker_NoTrigger() {
+        addCard(Zone.HAND, playerA, archnemesis); // {1}{U}{B}
+        addCard(Zone.BATTLEFIELD, playerA, "Underground Sea", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Grizzly Bears"); // 2/2
+        addCard(Zone.BATTLEFIELD, playerA, "Silvercoat Lion"); // 2/2
+        //
+        addCard(Zone.BATTLEFIELD, playerB, "Ajani Goldmane"); // planeswalker, loyalty 4
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, archnemesis, playerB);
+        attack(1, playerA, "Grizzly Bears", playerC);
+        attack(1, playerA, "Silvercoat Lion", "Ajani Goldmane");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertLife(playerA, 20);
+        assertLife(playerB, 20);
+        assertLife(playerC, 20 - 2);
+        assertCounterCount(playerB, "Ajani Goldmane", CounterType.LOYALTY, 4 - 2);
+        assertHandCount(playerA, 1); // turn draw only
+    }
+
+    @Test
+    public void test_OtherPlayerAttacksEnchantedPlayer_NoTrigger() {
+        addCard(Zone.HAND, playerA, archnemesis); // {1}{U}{B}
+        addCard(Zone.BATTLEFIELD, playerA, "Underground Sea", 3);
+        //
+        addCard(Zone.BATTLEFIELD, playerC, "Grizzly Bears"); // 2/2
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, archnemesis, playerB);
+        attack(3, playerC, "Grizzly Bears", playerB);
+
+        setStrictChooseMode(true);
+        setStopAt(3, PhaseStep.END_TURN);
+        execute();
+
+        assertLife(playerA, 20);
+        assertLife(playerB, 20 - 2); // bear only
+    }
+
+    @Test
+    public void test_PlayerAttacksYou_AttachToThatPlayer() {
+        addCard(Zone.HAND, playerA, archnemesis); // {1}{U}{B}
+        addCard(Zone.BATTLEFIELD, playerA, "Underground Sea", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Silvercoat Lion"); // 2/2
+        //
+        addCard(Zone.BATTLEFIELD, playerD, "Grizzly Bears"); // 2/2
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, archnemesis, playerB);
+
+        // turn 2: playerD attacks playerA, Archnemesis moves from playerB to playerD
+        attack(2, playerD, "Grizzly Bears", playerA);
+        setChoice(playerA, true); // attach to playerD
+
+        // turn 5: attacking playerD triggers it now
+        attack(5, playerA, "Silvercoat Lion", playerD);
+
+        setStrictChooseMode(true);
+        setStopAt(5, PhaseStep.END_TURN);
+        execute();
+
+        assertLife(playerA, 20 - 2 + 2);
+        assertLife(playerB, 20);
+        assertLife(playerD, 20 - 2 - 2); // trigger + lion
+        // the client shows player's auras by the player's attachments
+        Assert.assertTrue("playerB must lose the aura", playerB.getAttachments().isEmpty());
+        Assert.assertEquals("playerD must get the aura", 1, playerD.getAttachments().size());
+    }
+
+    @Test
+    public void test_PlayerAttacksYou_Decline() {
+        addCard(Zone.HAND, playerA, archnemesis); // {1}{U}{B}
+        addCard(Zone.BATTLEFIELD, playerA, "Underground Sea", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Silvercoat Lion"); // 2/2
+        //
+        addCard(Zone.BATTLEFIELD, playerD, "Grizzly Bears"); // 2/2
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, archnemesis, playerB);
+
+        attack(2, playerD, "Grizzly Bears", playerA);
+        setChoice(playerA, false); // keep it on playerB
+
+        attack(5, playerA, "Silvercoat Lion", playerB);
+
+        setStrictChooseMode(true);
+        setStopAt(5, PhaseStep.END_TURN);
+        execute();
+
+        assertLife(playerA, 20 - 2 + 2);
+        assertLife(playerB, 20 - 2 - 2); // trigger + lion
+        assertLife(playerD, 20);
+    }
+
+    @Test
+    public void test_PlayerAttacksYourPlaneswalkerOrOtherPlayer_NoTrigger() {
+        addCard(Zone.HAND, playerA, archnemesis); // {1}{U}{B}
+        addCard(Zone.BATTLEFIELD, playerA, "Underground Sea", 3);
+        addCard(Zone.BATTLEFIELD, playerA, "Ajani Goldmane"); // planeswalker, loyalty 4
+        //
+        addCard(Zone.BATTLEFIELD, playerD, "Grizzly Bears"); // 2/2
+        addCard(Zone.BATTLEFIELD, playerD, "Silvercoat Lion"); // 2/2
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, archnemesis, playerB);
+
+        // no attach choice: playerA isn't attacked
+        attack(2, playerD, "Grizzly Bears", "Ajani Goldmane");
+        attack(2, playerD, "Silvercoat Lion", playerC);
+
+        setStrictChooseMode(true);
+        setStopAt(2, PhaseStep.END_TURN);
+        execute();
+
+        assertCounterCount(playerA, "Ajani Goldmane", CounterType.LOYALTY, 4 - 2);
+        assertLife(playerC, 20 - 2);
+    }
+}
