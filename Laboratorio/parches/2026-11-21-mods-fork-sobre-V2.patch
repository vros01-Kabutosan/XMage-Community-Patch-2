+        public StatusBadge(String text, Color bg) {
+            super(text, SwingConstants.CENTER);
+            this.bgColor = bg;
+            this.setFont(segoe(Font.BOLD, 10));
+            this.setForeground(Color.WHITE);
+            this.setBorder(new EmptyBorder(scale(3), scale(8), scale(3), scale(8)));
