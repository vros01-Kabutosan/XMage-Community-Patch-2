         // Read the half from the permanent, not the mutable card blueprint.
         SpellAbilityType castHalf = permanent.getRoomCastHalf();
+        RoomCard dbgBlueprint = (RoomCard) RoomCharacteristicsEffect.findRoomCard(permanent);
+        System.err.println("ROOMDBG apply perm=" + permanent.getId() + " class=" + permanent.getClass().getSimpleName()
+                + " name=" + permanent.getName() + " roomCastHalf=" + castHalf
+                + " blueprint=" + (dbgBlueprint == null ? "null"
