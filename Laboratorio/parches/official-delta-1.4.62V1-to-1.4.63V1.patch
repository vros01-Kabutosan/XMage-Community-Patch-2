+                res.add(((EntersTheBattlefieldEvent) event).getTarget());
+            } else if (event instanceof ZoneChangeEvent && ((ZoneChangeEvent) event).getToZone() == Zone.BATTLEFIELD) {
+                res.add(((ZoneChangeEvent) event).getTarget());
+            }
+        }
