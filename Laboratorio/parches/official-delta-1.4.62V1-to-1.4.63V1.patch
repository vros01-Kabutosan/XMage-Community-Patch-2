+        // return itself - its battlefield ability did not exist before the event
+        activateAbility(1, PhaseStep.PRECOMBAT_MAIN, playerA, "{5}{B}: Return");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
