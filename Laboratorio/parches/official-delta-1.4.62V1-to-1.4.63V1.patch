+        setStrictChooseMode(true);
+
+        addCard(Zone.BATTLEFIELD, playerA, spear);
+        addCard(Zone.BATTLEFIELD, playerA, lion);
+        addCard(Zone.BATTLEFIELD, playerA, solRing); // tapped to pay equip
