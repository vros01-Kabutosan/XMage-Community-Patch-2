+                .map(ZoneChangeEvent::getTarget)
+                .collect(Collectors.toList());
+    }
+
+    private List<ZoneChangeEvent> getLeftEvents(Game game) {
+        return getSourceEvents(game)
+                .stream()
+                .filter(ZoneChangeEvent.class::isInstance)
