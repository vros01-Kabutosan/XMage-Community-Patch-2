diff --git a/Mage/src/test/java/mage/abilities/assignment/RoleAssignmentTest.java b/Mage/src/test/java/mage/abilities/assignment/RoleAssignmentTest.java
new file mode 100644
index 00000000000..f8b57509caf
--- /dev/null
+++ b/Mage/src/test/java/mage/abilities/assignment/RoleAssignmentTest.java
@@ -0,0 +1,163 @@
+package mage.abilities.assignment;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.util.*;
+
+/**
+ * Unit tests for the roles assignment algorithm (maximum bipartite matching between cards and roles),
+ * used by party count, "a card of each card type" targets, etc
+ *
+ * @author JayDi85
+ */
+public class RoleAssignmentTest {
+
+    private static Set<String> roles(String... roles) {
+        return new LinkedHashSet<>(Arrays.asList(roles));
+    }
+
+    /**
+     * Check the result for every order of cards
+     */
+    private static void assertAssignment(int needCount, List<Set<String>> cardRoles) {
+        List<List<Set<String>>> orders = new ArrayList<>();
+        permutations(new ArrayList<>(cardRoles), 0, orders);
+        for (List<Set<String>> order : orders) {
+            Assert.assertEquals("wrong roles count for cards order " + order, needCount, RoleAssignment.getMaxAssignment(order));
+        }
+    }
+
+    private static void permutations(List<Set<String>> list, int index, List<List<Set<String>>> res) {
+        if (index == list.size()) {
+            res.add(new ArrayList<>(list));
+            return;
+        }
+        for (int i = index; i < list.size(); i++) {
+            Collections.swap(list, index, i);
+            permutations(list, index + 1, res);
+            Collections.swap(list, index, i);
+        }
+    }
+
+    /**
+     * Reference result: try all possible assignments
+     */
+    private static int bruteForce(List<Set<String>> cardRoles, int cardIndex, Set<String> usedRoles) {
+        if (cardIndex == cardRoles.size()) {
+            return 0;
+        }
+        // card without role
+        int best = bruteForce(cardRoles, cardIndex + 1, usedRoles);
+        // card with one of the free roles
+        for (String role : cardRoles.get(cardIndex)) {
+            if (usedRoles.add(role)) {
+                best = Math.max(best, 1 + bruteForce(cardRoles, cardIndex + 1, usedRoles));
+                usedRoles.remove(role);
+            }
+        }
+        return best;
+    }
+
+    @Test
+    public void test_NoCards() {
+        assertAssignment(0, Arrays.asList());
+    }
+
+    @Test
+    public void test_CardsWithoutRoles() {
+        assertAssignment(0, Arrays.asList(roles()));
+        assertAssignment(0, Arrays.asList(roles(), roles()));
+        assertAssignment(1, Arrays.asList(roles(), roles("A", "B")));
+        assertAssignment(1, Arrays.asList(roles(), roles("A"), roles("A")));
+    }
+
+    @Test
+    public void test_DifferentRoles() {
+        assertAssignment(1, Arrays.asList(roles("A")));
+        assertAssignment(2, Arrays.asList(roles("A"), roles("B")));
+        assertAssignment(4, Arrays.asList(roles("A"), roles("B"), roles("C"), roles("D")));
+    }
+
+    @Test
+    public void test_SameRole() {
+        assertAssignment(1, Arrays.asList(roles("A"), roles("A")));
+        assertAssignment(1, Arrays.asList(roles("A"), roles("A"), roles("A")));
+    }
+
+    @Test
+    public void test_ManyCardsWithSameTwoRoles() {
+        // prod case: party with three Cleric Wizards and a Rogue Warrior
+        assertAssignment(2, Arrays.asList(roles("A", "B"), roles("A", "B"), roles("A", "B")));
+        assertAssignment(3, Arrays.asList(roles("A", "B"), roles("A", "B"), roles("A", "B"), roles("C", "D")));
+        assertAssignment(3, Arrays.asList(roles("A", "B"), roles("A", "B"), roles("A", "B"), roles("A"), roles("C", "D")));
+        assertAssignment(4, Arrays.asList(roles("A", "B"), roles("A", "B"), roles("A", "B"), roles("C"), roles("C", "D")));
+    }
+
+    @Test
+    public void test_NeedMoveOtherCards() {
+        // a card can get a role only if another card moves to its other role
+        assertAssignment(2, Arrays.asList(roles("A", "B"), roles("A")));
+        assertAssignment(3, Arrays.asList(roles("A", "B"), roles("B", "C"), roles("C")));
+        // long chain of moves
+        assertAssignment(4, Arrays.asList(roles("A", "B"), roles("B", "C"), roles("C", "D"), roles("D")));
+        assertAssignment(4, Arrays.asList(roles("A", "B", "C", "D"), roles("A"), roles("B"), roles("C")));
+    }
+
+    @Test
+    public void test_NotAllCardsCanGetRole() {
+        assertAssignment(2, Arrays.asList(roles("A"), roles("A"), roles("A", "B")));
+        assertAssignment(3, Arrays.asList(roles("A", "B", "C"), roles("A", "B"), roles("A", "B"), roles("A")));
+        assertAssignment(4, Arrays.asList(roles("A", "B"), roles("A", "B"), roles("A", "B"), roles("C", "D"), roles("C", "D"), roles("C", "D")));
+    }
+
+    @Test(timeout = 5000)
+    public void test_ManyCards() {
+        // party of many changelings
+        List<Set<String>> cardRoles = new ArrayList<>();
+        for (int i = 0; i < 100; i++) {
+            cardRoles.add(roles("A", "B", "C", "D"));
+        }
+        Assert.assertEquals(4, RoleAssignment.getMaxAssignment(cardRoles));
+
+        // many cards with same two roles and other roles
+        cardRoles.clear();
+        for (int i = 0; i < 100; i++) {
+            cardRoles.add(roles("A", "B"));
+        }
+        cardRoles.add(roles("C", "D"));
+        Assert.assertEquals(3, RoleAssignment.getMaxAssignment(cardRoles));
+
+        // many cards with own roles (e.g. a card of each card type in a big library)
+        cardRoles.clear();
+        for (int i = 0; i < 100; i++) {
+            cardRoles.add(roles("R" + i, "R" + (i + 1)));
+        }
+        Assert.assertEquals(100, RoleAssignment.getMaxAssignment(cardRoles));
+    }
+
+    @Test
+    public void test_RandomCards() {
+        // compare with all possible assignments
+        Random random = new Random(20261018);
+        String[] allRoles = {"A", "B", "C", "D", "E"};
+        for (int testNumber = 0; testNumber < 20000; testNumber++) {
+            int cardsAmount = random.nextInt(8);
+            int rolesAmount = 1 + random.nextInt(allRoles.length);
+            List<Set<String>> cardRoles = new ArrayList<>();
+            for (int i = 0; i < cardsAmount; i++) {
+                Set<String> cardRole = new LinkedHashSet<>();
+                for (int r = 0; r < rolesAmount; r++) {
+                    if (random.nextInt(3) == 0) {
+                        cardRole.add(allRoles[r]);
+                    }
+                }
+                cardRoles.add(cardRole);
+            }
+            int needCount = bruteForce(cardRoles, 0, new HashSet<>());
+            Assert.assertEquals("wrong roles count for cards " + cardRoles, needCount, RoleAssignment.getMaxAssignment(cardRoles));
+            Collections.shuffle(cardRoles, random);
+            Assert.assertEquals("wrong roles count for cards " + cardRoles, needCount, RoleAssignment.getMaxAssignment(cardRoles));
+        }
+    }
+}
diff --git a/Utils/check-set-printings.py b/Utils/check-set-printings.py
new file mode 100644
index 00000000000..11f1553aa40
--- /dev/null
+++ b/Utils/check-set-printings.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""
+Report cards that are implemented but whose printing (collector number) is not
+registered in the Java set class for the given set code.
+
+Usage: python3 Utils/check-set-printings.py <SET_CODE>
+
+Scryfall data is cached in Utils/data/<CODE>-scryfall.json (refetched if older than 24h).
+"""
+import json
+import os
+import re
+import sys
+import time
+import unicodedata
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+UTILS_DIR = os.path.dirname(os.path.abspath(__file__))
+DATA_DIR = os.path.join(UTILS_DIR, "data")
+SETS_DATA_FILE = os.path.join(UTILS_DIR, "mtg-sets-data.txt")
+SETS_JAVA_DIR = os.path.join(UTILS_DIR, "..", "Mage.Sets", "src", "mage", "sets")
+
+SET_CARD_INFO_RE = re.compile(r'new SetCardInfo\(\s*"((?:[^"\\]|\\.)*)"\s*,\s*("?[^",\s]+"?)\s*,')
+
+
+def is_file_stale(path, hours=24):
+    return not os.path.exists(path) or time.time() - os.path.getmtime(path) > hours * 3600
+
+
+def fetch_data(url):
+    cards = []
+    while url:
+        req = Request(url, headers={"User-Agent": "mage-scryfall-sync/1.0", "Accept": "application/json"})
+        try:
+            with urlopen(req) as response:
+                payload = json.loads(response.read().decode("utf-8"))
+        except HTTPError as e:
+            raise SystemExit(f"HTTP error {e.code} for {url}")
+        except URLError as e:
+            raise SystemExit(f"Network error for {url}: {e.reason}")
+        cards.extend(payload["data"])
+        url = payload.get("next_page")
+    return {"data": cards}
+
+
+def load_scryfall(code):
+    path = os.path.join(DATA_DIR, code.upper() + "-scryfall.json")
+    if is_file_stale(path):
+        print(f"Fetching fresh data for {code} ...")
+        query = urlencode({"q": f"s:{code}", "order": "set", "unique": "prints", "include_extras": "true"})
+        os.makedirs(DATA_DIR, exist_ok=True)
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(fetch_data(f"https://api.scryfall.com/cards/search?{query}"), f)
+    else:
+        print(f"Using cached data for {code}")
+    with open(path, encoding="utf-8") as f:
+        return json.load(f)["data"]
+
+
+def normalize(name):
+    name = unicodedata.normalize("NFD", name.replace('\\"', '"'))
+    return "".join(c for c in name if unicodedata.category(c) != "Mn").lower()
+
+
+def set_name_for_code(code):
+    with open(SETS_DATA_FILE, encoding="utf-8") as f:
+        for line in f:
+            parts = line.rstrip("\n").split("|")
+            if len(parts) >= 2 and parts[1].upper() == code.upper():
+                return parts[0]
+    raise SystemExit(f"Set code {code} not found in {SETS_DATA_FILE}")
+
+
+def read_registrations(java_file):
+    """Returns {normalized name: set of collector numbers} for a Java file."""
+    result = {}
+    with open(java_file, encoding="utf-8") as f:
+        for name, number in SET_CARD_INFO_RE.findall(f.read()):
+            result.setdefault(normalize(name), set()).add(number.strip('"').lower())
+    return result
+
+
+def find_set_class(code, set_name):
+    pattern = re.compile(r'super\(\s*"' + re.escape(set_name) + r'"\s*,\s*"' + re.escape(code.upper()) + '"')
+    for file in sorted(os.listdir(SETS_JAVA_DIR)):
+        if not file.endswith(".java"):
+            continue
+        path = os.path.join(SETS_JAVA_DIR, file)
+        with open(path, encoding="utf-8") as f:
+            if pattern.search(f.read()):
+                return path
+    raise SystemExit(f"No Java set class found for '{set_name}' ({code.upper()}) in {SETS_JAVA_DIR}")
+
+
+def all_implemented_names():
+    names = set()
+    for file in os.listdir(SETS_JAVA_DIR):
+        if file.endswith(".java"):
+            names.update(read_registrations(os.path.join(SETS_JAVA_DIR, file)))
+    return names
+
+
+def card_name_variants(card):
+    full = card["name"]
+    variants = {normalize(full)}
+    variants.update(normalize(part.strip()) for part in full.split("//"))
+    return variants
+
+
+def main():
+    if len(sys.argv) != 2 or not re.fullmatch(r"[A-Za-z0-9]+", sys.argv[1]):
+        raise SystemExit(f"Usage: {os.path.basename(sys.argv[0])} <SET_CODE>")
+    code = sys.argv[1]
+
+    set_name = set_name_for_code(code)
+    java_file = find_set_class(code, set_name)
+    print(f"{set_name} ({code.upper()}) -> {os.path.relpath(java_file, os.path.join(UTILS_DIR, '..'))}")
+
+    registered = read_registrations(java_file)
+    implemented = all_implemented_names()
+
+    missing = []
+    for card in load_scryfall(code):
+        number = card["collector_number"].lower()
+        variants = card_name_variants(card)
+        if not variants & implemented:
+            continue  # card itself not implemented, out of scope
+        if any(number in registered.get(v, ()) for v in variants):
+            continue
+        missing.append((card["collector_number"], card["name"]))
+
+    if not missing:
+        print("All printings of implemented cards are registered.")
+        return
+
+    def sort_key(item):
+        digits = re.sub(r"\D", "", item[0])
+        return int(digits) if digits else 0, item[0]
+
+    print(f"\n{len(missing)} implemented printing(s) not registered:")
+    for number, name in sorted(missing, key=sort_key):
+        print(f"  {number}\t{name}")
+
+
+if __name__ == "__main__":
+    main()
